{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lil edit",
  "version": "0.2.0",
  "identifier": "com.lil.edit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lil edit",
        "width": 1100,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/jpeg",
        "contentTypes": [
          "public.jpeg"
        ]
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/png",
        "contentTypes": [
          "public.png"
        ]
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/webp",
        "contentTypes": [
          "org.webmproject.webp"
        ]
      },
      {
        "ext": [
          "avif"
        ],
        "name": "AVIF image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/avif",
        "contentTypes": [
          "public.avif"
        ]
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/gif",
        "contentTypes": [
          "com.compuserve.gif"
        ]
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "BMP image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/bmp",
        "contentTypes": [
          "com.microsoft.bmp"
        ]
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF image",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "image/tiff",
        "contentTypes": [
          "public.tiff"
        ]
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
